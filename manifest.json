{
  "manifest_version": 3,
  "minimum_chrome_version": "99",
  "name": "ページ全体スクリーンショット",
  "version": "1.1.0",
  "description": "右クリック・アイコン・ショートカットからページ全体を撮影し、PNGをクリップボードにコピーする。保存もダウンロードもしない。",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "notifications",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "ページ全体をスクリーンショット"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}
